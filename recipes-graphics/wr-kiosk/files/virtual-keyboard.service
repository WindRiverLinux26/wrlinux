[Unit]
Description=Virtual Keyboard for Kiosk Mode
Requires=network.target xserver-nodm.service web-kiosk.service
After=network.target xserver-nodm.service web-kiosk.service

[Service]
Type=simple
User=kiosk
Environment=DISPLAY=:0
ExecStartPre=gsettings set org.gnome.desktop.interface toolkit-accessibility true
ExecStartPre=gsettings set org.onboard show-status-icon false
ExecStartPre=gsettings set org.onboard show-tooltips false
ExecStartPre=gsettings set org.onboard.auto-show enabled true
ExecStartPre=gsettings set org.onboard.icon-palette in-use false
ExecStartPre=gsettings set org.onboard.window docking-enabled true
ExecStart=@BINDIR@/onboard

[Install]
WantedBy=multi-user.target
